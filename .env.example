# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_RAW_TOPIC=raw-search-events
KAFKA_METRICS_TOPIC=processed-metrics
KAFKA_ANOMALIES_TOPIC=anomaly-alerts

# PostgreSQL
POSTGRES_USER=searchmetrics
POSTGRES_PASSWORD=searchmetrics
POSTGRES_DB=search_metrics
DATABASE_URL=postgresql://searchmetrics:searchmetrics@postgres:5432/search_metrics

# Spark
SPARK_MASTER=spark://spark-master:7077

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Traffic simulator
EVENTS_PER_MINUTE=1000
SERVICE_IDS=search-api,recommendations,indexer,ranking
